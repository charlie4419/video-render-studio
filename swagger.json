  "info": {
    "title": "Video Render API",
    "description": "AI Animation Studio API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateSeriesDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "에반맨"
          },
          "description": {
            "type": "string",
            "example": "슈퍼히어로 이반의 모험"
          },
          "stylePrompt": {
            "type": "string",
            "example": "anime style, vibrant colors, action"
          },
          "thumbnail": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      },
      "UpdateSeriesDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "에반맨"
          },
          "description": {
            "type": "string",
            "example": "슈퍼히어로 이반의 모험"
          },
          "stylePrompt": {
            "type": "string",
            "example": "anime style, vibrant colors, action"
          },
          "thumbnail": {
            "type": "string"
          }
        }
      },
      "CreateEpisodeDto": {
        "type": "object",
        "properties": {
          "episodeNumber": {
            "type": "number",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "첫 번째 모험"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "episodeNumber",
          "title"
        ]
      },
      "UpdateEpisodeDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "SCRIPT_READY",
              "SCENE_READY",
              "VOICE_READY",
              "RENDERING",
              "COMPLETED",
              "FAILED"
            ]
          },
          "thumbnail": {
            "type": "string"
          }
        }
      },
      "GenerateScriptDto": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "추가 지시사항 (선택)"
          }
        }
      },
      "UpdateScriptDto": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "GENERATING",
              "READY",
              "APPROVED",
              "FAILED"
            ]
          }
        }
      },
      "UpdateSceneDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "narration": {
            "type": "string"
          },
          "duration": {
            "type": "number"
          },
          "emotion": {
            "type": "string"
          },
          "background": {
            "type": "string"
          },
          "cameraDirection": {
            "type": "string"
          },
          "dialogueJson": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "IMAGE_GENERATING",
              "IMAGE_READY",
              "VOICE_GENERATING",
              "VOICE_READY",
              "RENDERING",
              "COMPLETED",
              "FAILED"
            ]
          }
        }
      },
      "GenerateSceneImageDto": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "추가 이미지 프롬프트"
          },
          "negativePrompt": {
            "type": "string"
          },
          "style": {
            "type": "string",
            "example": "anime, cinematic"
          },
          "width": {
            "type": "number",
            "example": 1920
          },
          "height": {
            "type": "number",
            "example": 1080
          }
        }
      },
      "GenerateTtsDto": {
        "type": "object",
        "properties": {
          "voiceId": {
            "type": "string",
            "description": "사용할 음성 ID (OpenAI voice name)"
          },
          "characterId": {
            "type": "string",
            "description": "특정 캐릭터 ID"
          },
          "speed": {
            "type": "number",
            "description": "재생 속도",
            "example": 1
          }
        }
      },
      "ImageToVideoDto": {
        "type": "object",
        "properties": {
          "motionPrompt": {
            "type": "string",
            "description": "움직임 묘사 프롬프트 (예: \"캐릭터가 손짓하며 설명하는 동작\")",
            "example": "character explaining with gentle hand gestures"
          },
          "duration": {
            "type": "number",
            "enum": [
              5,
              10
            ],
            "description": "생성 영상 길이(초)",
            "example": 5
          },
          "aspectRatio": {
            "type": "string",
            "enum": [
              "16:9",
              "9:16",
              "1:1"
            ],
            "description": "화면 비율 (쇼츠: 9:16)",
            "example": "9:16"
          }
        }
      },
      "RenderClipDto": {
        "type": "object",
        "properties": {
          "motionEffect": {
            "type": "string",
            "enum": [
              "zoom_in",
              "zoom_out",
              "pan_right",
              "pan_left",
              "ken_burns",
              "none",
              "shake",
              "flash",
              "impact_zoom",
              "speed_pan",
              "strobe"
            ],
            "description": "모션 효과 (zoom_in/zoom_out/pan_right/pan_left/ken_burns/none/shake/flash/impact_zoom/speed_pan/strobe)",
            "example": "impact_zoom"
          }
        }
      },
      "CreateCharacterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "에반"
          },
          "description": {
            "type": "string"
          },
          "age": {
            "type": "number",
            "example": 17
          },
          "gender": {
            "type": "string",
            "example": "남성"
          },
          "personality": {
            "type": "string"
          },
          "basePrompt": {
            "type": "string",
            "description": "이미지 생성용 기본 프롬프트"
          },
          "voiceType": {
            "type": "string",
            "description": "음성 타입 (OpenAI voice ID: alloy, ash, coral, echo, fable, nova, onyx, sage, shimmer)"
          },
          "elevenLabsVoiceType": {
            "type": "string",
            "description": "ElevenLabs 음성 타입 (adam, arnold, antoni, elli, domi, rachel, bella, josh, sam)",
            "example": "rachel"
          },
          "typecastVoiceType": {
            "type": "string",
            "description": "Typecast actor_id (Typecast 대시보드에서 확인)"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateCharacterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "에반"
          },
          "description": {
            "type": "string"
          },
          "age": {
            "type": "number",
            "example": 17
          },
          "gender": {
            "type": "string",
            "example": "남성"
          },
          "personality": {
            "type": "string"
          },
          "basePrompt": {
            "type": "string",
            "description": "이미지 생성용 기본 프롬프트"
          },
          "voiceType": {
            "type": "string",
            "description": "음성 타입 (OpenAI voice ID: alloy, ash, coral, echo, fable, nova, onyx, sage, shimmer)"
          },
          "elevenLabsVoiceType": {
            "type": "string",
            "description": "ElevenLabs 음성 타입 (adam, arnold, antoni, elli, domi, rachel, bella, josh, sam)",
            "example": "rachel"
          },
          "typecastVoiceType": {
            "type": "string",
            "description": "Typecast actor_id (Typecast 대시보드에서 확인)"
          }
        }
      },
      "CreateCharacterReferenceDto": {
        "type": "object",
        "properties": {
          "imageUrl": {
            "type": "string",
            "description": "이미지 URL"
          },
          "type": {
            "type": "string",
            "description": "레퍼런스 타입",
            "example": "FRONT"
          },
          "prompt": {
            "type": "string",
            "description": "이미지 프롬프트"
          }
        },
        "required": [
          "imageUrl",
          "type"
        ]
      },
      "CreateAssetDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "BGM",
              "SFX",
              "BACKGROUND",
              "OVERLAY",
              "FONT"
            ]
          },
          "title": {
            "type": "string",
            "example": "배경음악 1"
          },
          "url": {
            "type": "string",
            "description": "S3/CDN URL"
          },
          "tags": {
            "example": [
              "action",
              "intense"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metadata": {
            "type": "object"
          }
        },
        "required": [
          "type",
          "title",
          "url"
        ]
      }
    }
  }
}